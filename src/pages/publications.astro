---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPublications } from '../utils/content';
import { formatDate } from '../utils/formatDate';

const pubs = await getPublications();
---

<SiteLayout
  title="Publications"
  description="Papers, posters and technical reports."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Publications' }]}
>
  <h1 class="section-title !text-[2rem]">Publications</h1>
  <p class="mb-8 text-lg text-muted">Papers, posters and technical reports.</p>
  {
    pubs.map((p) => (
      <article class="border-t border-line py-6 first:border-t-0 first:pt-0">
        <p class="text-sm font-semibold uppercase tracking-wider text-muted">
          {p.data.kind} · {formatDate(p.data.date)} · {p.data.language}
        </p>
        <h2 class="mt-1 font-serif text-[1.35rem] leading-snug">
          {p.data.link ? (
            <a href={p.data.link} class="link" target="_blank" rel="noopener noreferrer">{p.data.title} ↗</a>
          ) : (
            p.data.title
          )}
        </h2>
        <p class="mt-1 text-[1.02rem] text-muted">{p.data.venue}</p>
        {p.data.authors.length > 0 && <p class="text-[1.02rem]">{p.data.authors.join(', ')}</p>}
      </article>
    ))
  }
  {pubs.length === 0 && <p class="text-muted">Nothing here yet.</p>}
</SiteLayout>
