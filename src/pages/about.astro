---
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../data/site';

const education = [
  {
    name: "SUP'COM",
    fullName: 'École Supérieure des Communications de Tunis',
    degree: 'ICT Engineering Student · Multimodal Information Application',
    period: 'Sep 2024 – Jan 2027',
    description:
      'Engineering degree in Telecommunications and ICT, with a focus on artificial intelligence, machine learning, signal processing, and multimodal applications.',
    skills: [
      'Python',
      'PyTorch',
      'TensorFlow',
      'Scikit-learn',
      'Computer Vision',
      'Signal Processing',
      'Machine Learning',
    ],
    logo: '/images/education/supcom.png',
  },
  {
    name: 'IPEIM',
    fullName: 'Preparatory Institute for Engineering Studies of Monastir',
    degree: 'Scientific Preparatory Classes — Mathematics & Physics',
    period: 'Sep 2022 – May 2024',
    description:
      'Completed an intensive mathematics and physics preparatory curriculum for competitive engineering school admission.',
    achievements: [
      'Developed strong foundations in advanced mathematics, physics, and analytical problem solving.',
      'Ranked 159th among 1,714 candidates in the national engineering school entrance examination.',
    ],
    skills: [
      'Advanced Mathematics',
      'Physics',
      'Scientific Computing',
      'Problem Solving',
    ],
    logo: '/images/education/ipeim.png',
  },
];

const interests = [
  'Medical imaging and neuroscience',
  'Biomedical signals and non-intrusive monitoring',
  'Efficient deep learning on embedded devices (TinyML)',
  'Applying LLMs to security analysis',
];

const hobbies = [
  'Add your first hobby',
  'Add your second hobby',
  'Add your third hobby',
];
---

<SiteLayout
  title="About"
  description="My background, education, interests and hobbies."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]}
>
  <div class="space-y-14">

    <!-- About -->
    <section>
      <h1 class="section-title !text-[2rem]">About</h1>

      <p class="text-[1.1rem] leading-relaxed">
        I'm a 3rd-year ICT Engineering student at SUP’COM Tunisia,
        specializing in Multimodal Information Application. My work focuses
        on artificial intelligence, machine learning and deep learning,
        with a particular interest in healthcare AI, medical imaging,
        neuroscience and biomedical signal processing.
      </p>

      <p class="mt-4 text-[1.1rem] leading-relaxed">
        I'm interested in developing intelligent, explainable and efficient
        systems that address real-world challenges, from medical image
        analysis to embedded AI.
      </p>
    </section>

    <!-- Education -->
    <section>
      <h2 class="section-title">Education</h2>

      <div class="mt-7 space-y-8">
        {education.map((item) => (
          <article class="flex flex-col gap-5 rounded-2xl border border-slate-200 p-6 dark:border-slate-700 sm:flex-row">
            <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-xl bg-white p-2">
              <img
                src={item.logo}
                alt={`${item.name} logo`}
                class="max-h-full max-w-full object-contain"
                loading="lazy"
              />
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                  <h3 class="text-xl font-semibold">{item.name}</h3>
                  <p class="text-sm text-slate-500 dark:text-slate-400">
                    {item.fullName}
                  </p>
                </div>

                <span class="text-sm font-medium text-slate-500 dark:text-slate-400">
                  {item.period}
                </span>
              </div>

              <p class="mt-3 font-medium">{item.degree}</p>

              <p class="mt-2 leading-relaxed text-slate-600 dark:text-slate-300">
                {item.description}
              </p>

              {item.achievements && (
                <ul class="mt-3 list-disc space-y-1 pl-5 text-slate-600 dark:text-slate-300">
                  {item.achievements.map((achievement) => (
                    <li>{achievement}</li>
                  ))}
                </ul>
              )}

              <div class="mt-4 flex flex-wrap gap-2">
                {item.skills.map((skill) => (
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Interests -->
    <section>
      <h2 class="section-title">Interests</h2>

      <ul class="mt-5 list-disc space-y-2 pl-5 text-[1.05rem] marker:text-slate-400">
        {interests.map((interest) => <li>{interest}</li>)}
      </ul>
    </section>

    <!-- Hobbies -->
    <!-- Beyond Engineering -->
<!-- Beyond Engineering -->
<section>
  <h2 class="section-title">Beyond Engineering</h2>

  <p class="mt-3 leading-relaxed">
    Beyond engineering, I enjoy creative expression, visual storytelling
    and activities that challenge my imagination and strategic thinking.
  </p>

  <!-- Content Creation Portfolio -->
  <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700">
    <img
      src="/images/hobbies/content-creation.jpg"
      alt="Digital content creation and visual communication"
      class="h-56 w-full object-cover"
      loading="lazy"
    />

    <div class="p-5">
      <p class="text-sm text-slate-500 dark:text-slate-400">Creative Work</p>
      <h3 class="mt-1 text-xl font-semibold">Digital Content Creation</h3>
      <p class="mt-2 leading-relaxed text-slate-600 dark:text-slate-300">
        Exploring visual communication, creative storytelling and social media
        content through digital projects.
      </p>
      <a
        class="link mt-3 inline-block"
        href="https://nourgaida.framer.website/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Explore my portfolio →
      </a>
    </div>
  </div>

  <!-- Hobbies Gallery -->
  <h3 class="mt-10 text-lg font-semibold">My Hobbies</h3>

  <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-3">

    <article>
      <img
        src="/images/hobbies/painting.png"
        alt="Painting and artistic creativity"
        class="h-48 w-full rounded-xl object-cover"
        loading="lazy"
      />
      <h4 class="mt-3 font-semibold">Painting</h4>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Expressing creativity through colors, textures and art.
      </p>
    </article>

    <article>
      <img
        src="/images/hobbies/chess.png"
        alt="Chess board"
        class="h-48 w-full rounded-xl object-cover"
        loading="lazy"
      />
      <h4 class="mt-3 font-semibold">Chess</h4>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Enjoying strategy, logical thinking and challenging decisions.
      </p>
    </article>

    <article>
      <img
        src="/images/hobbies/photography.png"
        alt="Photography and visual storytelling"
        class="h-48 w-full rounded-xl object-cover"
        loading="lazy"
      />
      <h4 class="mt-3 font-semibold">Photography</h4>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Capturing moments, details and perspectives through photography.
      </p>
    </article>

  </div>
</section>

    <!-- Contact -->
    <section>
      <h2 class="section-title">Contact</h2>

      <p class="mt-3 text-[1.05rem] leading-relaxed">
        The easiest way to reach me is by
        <a class="link" href={`mailto:${site.email}`}>email</a>, or on
        <a class="link" href={site.social[1].href} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        and
        <a class="link" href={site.social[0].href} target="_blank" rel="noopener noreferrer">GitHub</a>.
      </p>
    </section>

  </div>
</SiteLayout>