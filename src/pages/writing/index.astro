---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getWriting } from '../../utils/content';

const posts = await getWriting();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort((a, b) => a.localeCompare(b));
---

<SiteLayout
  title="Writing"
  description="Technical articles and research notes on AI, healthcare and embedded systems."
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Writing' }]}
>
  <h1 class="section-title !text-[2rem]">Writing</h1>
  <p class="mb-6 text-lg text-muted">Technical articles and research notes.</p>

  {
    tags.length > 0 && (
      <div class="mb-8 flex flex-wrap gap-2" id="tag-filter">
        <button type="button" data-tag="" class="tag-btn rounded-full border border-accent bg-accentSoft px-3 py-1 text-sm text-accent">
          All
        </button>
        {tags.map((t) => (
          <button type="button" data-tag={t.toLowerCase()} class="tag-btn rounded-full border border-line px-3 py-1 text-sm text-muted hover:border-accent hover:text-accent">
            {t}
          </button>
        ))}
      </div>
    )
  }

  <div id="articles">
    {posts.map((p) => <ArticleCard entry={p} />)}
    {posts.length === 0 && <p class="text-muted">Articles coming soon.</p>}
  </div>
</SiteLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
  const cards = document.querySelectorAll<HTMLElement>('.article-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag ?? '';
      buttons.forEach((b) => {
        const on = b === btn;
        b.classList.toggle('border-accent', on);
        b.classList.toggle('bg-accentSoft', on);
        b.classList.toggle('text-accent', on);
        b.classList.toggle('border-line', !on);
        b.classList.toggle('text-muted', !on);
      });
      cards.forEach((c) => {
        const tags = (c.dataset.tags ?? '').split('|');
        c.classList.toggle('hidden', tag !== '' && !tags.includes(tag));
      });
    });
  });
</script>
