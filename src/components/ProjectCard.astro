---
import type { CollectionEntry } from 'astro:content';
import TagBadge from './TagBadge.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const { title, summary, domain, stack, draft } = entry.data;
---

<article class="border-t border-line py-6 first:border-t-0 first:pt-0">
  <h3 class="font-serif text-[1.35rem] leading-snug">
    <a href={`/projects/${entry.slug}/`} class="text-accent hover:underline underline-offset-4">
      {title}
    </a>
    {
      draft && (
        <span class="ml-2 rounded bg-amber-100 px-2 py-0.5 align-middle font-sans text-xs text-amber-800">
          Draft
        </span>
      )
    }
  </h3>
  <p class="mt-1 text-sm font-semibold uppercase tracking-wider text-muted">{domain}</p>
  <p class="mt-2 text-[1.05rem] leading-relaxed text-ink/90">{summary}</p>
  {
    stack.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {stack.map((s) => (
          <TagBadge label={s} />
        ))}
      </div>
    )
  }
</article>
